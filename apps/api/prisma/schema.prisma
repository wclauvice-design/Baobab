generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum DeliveryMode {
  STANDARD
  EXPRESS
}

enum PaymentProviderType {
  MANUAL_ORANGE_MONEY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum PaymentAuditAction {
  VALIDATE
  REJECT
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  role          Role     @default(BUYER)
  country       String?
  language      String   @default("fr")
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  seller        Seller?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  paymentAudits PaymentAudit[]
  addresses     Address[]
  follows       Follow[]
  coupons       Coupon[]
  verifiedPhoneAt DateTime?
  customer Customer?
}

model Address {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  label       String
  fullAddress String
  city        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Follow {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([buyerId, sellerId])
}

model Coupon {
  id             String    @id @default(cuid())
  buyerId        String
  buyer          User      @relation(fields: [buyerId], references: [id])
  label          String
  discountAmount Decimal   @db.Decimal(12, 2)
  isUsed         Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Seller {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id])
  shopName  String
  city      String
  status    SellerStatus @default(PENDING)
  createdAt DateTime     @default(now())

  products Product[]
  follows  Follow[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  universe  String     @default("classifieds")
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  image     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String?
  seller      Seller?  @relation(fields: [sellerId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name           String
  description    String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency       String   @default("XOF")
  stock       Int      @default(0)
  images      String[]
  createdAt   DateTime @default(now())

  supplierPrice Decimal? @db.Decimal(12, 2)
  moderation String @default("PUBLISHED")
  moderationNote String?
  subcategory String @default("Autres")
  condition String @default("NEW")
  location String @default("Dubaï")
  minimumOrder Int @default(1)
  packSize Int @default(1)
  unit String @default("pièce")
  shippingIncluded Boolean @default(false)
  shippingDestination String?
  weightKg Decimal? @db.Decimal(10, 3)
  dimensions String?
  attributes Json @default("{}")
  orderItems OrderItem[]
  reviews    Review[]
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String
  buyer           User          @relation(fields: [buyerId], references: [id])
  status          OrderStatus   @default(PENDING_PAYMENT)
  totalAmount     Decimal       @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(12, 2)
  currency        String        @default("XOF")
  deliveryAddress String
  deliveryMode    DeliveryMode  @default(STANDARD)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  items           OrderItem[]
  payment         Payment?
  deliveryEvents  DeliveryEvent[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
}

model Payment {
  id           String              @id @default(cuid())
  orderId      String              @unique
  order        Order               @relation(fields: [orderId], references: [id])
  provider     PaymentProviderType
  reference    String              @unique
  status       PaymentStatus       @default(PENDING)
  amount       Decimal             @db.Decimal(12, 2)
  validatedBy  String?
  validatedAt  DateTime?
  createdAt    DateTime            @default(now())

  audits PaymentAudit[]
}

model PaymentAudit {
  id        String             @id @default(cuid())
  paymentId String
  payment   Payment            @relation(fields: [paymentId], references: [id])
  adminId   String
  admin     User               @relation(fields: [adminId], references: [id])
  action    PaymentAuditAction
  amount    Decimal            @db.Decimal(12, 2)
  createdAt DateTime           @default(now())
}

model DeliveryEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  createdAt DateTime @default(now())
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  content   String
  sentAt    DateTime            @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())
  firstName String
  lastName String
  phone String @unique
  whatsapp String?
  email String?
  country String
  city String
  address String
  messagingOptIn Boolean @default(false)
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversations Conversation[]
  tradeOrders TradeOrder[]
}

model BusinessSetting {
  key String @id
  value String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(cuid())
  tokenHash String @unique
  productId String?
  subject String
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  state String @default("OPEN")
  needsReply Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages ChatMessage[]
  tradeOrders TradeOrder[]
}

model ChatMessage {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
  role String
  body String
  requestKey String
  createdAt DateTime @default(now())
  @@unique([conversationId, requestKey])
  @@index([conversationId, createdAt])
}

model TradeOrder {
  id String @id @default(cuid())
  reference String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  trackingHash String @unique
  status String @default("DRAFT")
  currentRevision Int @default(0)
  acceptedRevision Int?
  acceptedAt DateTime?
  logisticsFinalized Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes TradeQuote[]
  entries TradeEntry[]
  events TradeEvent[]
  notices TradeNotice[]
  @@index([customerId])
}

model TradeQuote {
  id String @id @default(cuid())
  orderId String
  order TradeOrder @relation(fields: [orderId], references: [id])
  revision Int
  lines Json
  productTotal Decimal @db.Decimal(12, 2)
  supplierTotal Decimal @db.Decimal(12, 2)
  logisticsCharge Decimal @db.Decimal(12, 2)
  logisticsEstimate Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  terms String
  destination String
  paymentMode String
  dueDate DateTime?
  estimatedDelivery String?
  expiresAt DateTime
  createdBy String
  createdAt DateTime @default(now())
  @@unique([orderId, revision])
}

model TradeEntry {
  id String @id @default(cuid())
  orderId String
  order TradeOrder @relation(fields: [orderId], references: [id])
  kind String
  amount Decimal @db.Decimal(12, 2)
  state String @default("CONFIRMED")
  reference String
  note String?
  supplierId String?
  requestKey String
  createdBy String
  confirmedBy String?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  @@unique([orderId, requestKey])
}

model TradeEvent {
  id String @id @default(cuid())
  orderId String
  order TradeOrder @relation(fields: [orderId], references: [id])
  status String
  message String
  createdBy String
  createdAt DateTime @default(now())
}

model TradeNotice {
  id String @id @default(cuid())
  orderId String
  order TradeOrder @relation(fields: [orderId], references: [id])
  body String
  channel String
  state String @default("PENDING")
  processingAt DateTime?
  attempts Int @default(0)
  @@index([state, createdAt])
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
}
