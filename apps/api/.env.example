DATABASE_URL="postgresql://baobab:baobab@localhost:5432/baobab?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
ORANGE_MONEY_MERCHANT_NUMBER="+225 07 00 00 00 00"
ORDER_EXPIRATION_MINUTES=45

# Stockage des photos produits (bucket public "product-images" créé dans le
# même projet Supabase que la base de données). Sans ces variables, l'envoi
# de photos échoue mais le reste de l'app fonctionne normalement.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-dashboard"
SUPABASE_STORAGE_BUCKET="product-images"

# Temporaire : active POST /auth/dev-login (connexion sans OTP, limitée aux
# 3 numéros de seed) le temps de brancher un vrai fournisseur SMS. À retirer
# ensuite avec AuthService.devLogin().
ENABLE_DEV_LOGIN="true"
