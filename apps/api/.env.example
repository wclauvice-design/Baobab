DATABASE_URL="postgresql://westzone:westzone@localhost:5432/westzone?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
ORANGE_MONEY_MERCHANT_NUMBER="+225 07 00 00 00 00"
ORDER_EXPIRATION_MINUTES=45

# Stockage des photos produits (bucket public "product-images" créé dans le
# même projet Supabase que la base de données). Sans ces variables, l'envoi
# de photos échoue mais le reste de l'app fonctionne normalement.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-dashboard"
SUPABASE_STORAGE_BUCKET="product-images"

# Temporaire : active POST /auth/dev-login (connexion sans OTP, limitée aux
# 3 numéros de seed) le temps de brancher un vrai fournisseur SMS. À retirer
# ensuite avec AuthService.devLogin().
# Sécurité dev-login : laisser à "false" en production.
# ENABLE_DEV_LOGIN="true" exige DEV_LOGIN_WHITELIST (liste de numéros séparés
# par des virgules). Sans liste blanche, le mode reste fermé (fail-closed).
ENABLE_DEV_LOGIN="false"
DEV_LOGIN_WHITELIST="+22676950089"
# Uniquement pour le développement local, jamais en production.
DEV_LOGIN_ALLOW_ALL="false"

# Passerelle SMS réelle pour les codes OTP. Dès que SMS_GATEWAY_URL est
# défini, HttpSmsProvider remplace le journal de console.
# Contrat : POST JSON { to, message, sender } + Authorization: Bearer <token>.
# Exemple : un petit proxy vers Orange SMS API, Twilio ou un agrégateur local.
SMS_GATEWAY_URL=""
SMS_GATEWAY_TOKEN=""
SMS_SENDER="WESTZONE"
# Développement local uniquement : journalise le code OTP dans la console.
# Sans passerelle SMS et sans cette option, /auth/otp/request répond 503 pour
# ne jamais afficher « code envoyé » alors que rien n'est parti.
ALLOW_CONSOLE_OTP="false"
